rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    
    function isValidUser(data) {
      return data.displayName is string && data.displayName.size() > 0 && data.displayName.size() < 50 &&
             data.level is int && data.level >= 1 &&
             data.exp is int && data.exp >= 0;
    }

    function isValidSubmission(data) {
      return data.userId == request.auth.uid &&
             data.challengeId is string &&
             data.score is int && data.score >= 0 &&
             data.accuracy is number && data.accuracy >= 0 && data.accuracy <= 100;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    // MVP: 모두 열림 (중복 아이디 체크용 read + 가입용 create 필요)
    match /users/{userId} {
      allow read, create, update: if true;
    }

    match /challenges/{challengeId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
    }

    // MVP: 인증 없이 열어둠. 프로덕션 전 반드시 isAuthenticated() + isValidSubmission()로 복원
    match /submissions/{submissionId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }
  }
}
